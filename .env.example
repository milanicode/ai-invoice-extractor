# Gemini (free tier, text + vision) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama (optional) — on host while using Docker:
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=
OLLAMA_MODEL=llava

# PDF handling
MIN_TEXT_CHARS=40
PDF_RENDER_SCALE=2.0
